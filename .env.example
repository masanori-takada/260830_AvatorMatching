NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
AI_PROVIDER=mock
# AI_PROVIDER=geminiのときだけ必須。実際のキーはここに書かないこと(値は空のまま)。
GEMINI_API_KEY=
# 任意。未設定なら gemini-3.5-flash-lite を使う。
# gemini-3.6-flash は回答をより多く会話へ織り込むが、待ち時間が約3倍になる。
GEMINI_MODEL=
# 限定公開用の合言葉。未設定のままだとゲートが無効になり誰でもアクセスできる状態になる。
# 実際の合言葉はここに書かないこと(値は空のまま)。
ACCESS_CODE=
